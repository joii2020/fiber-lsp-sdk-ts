{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "fiber-lsp-sdk": ["./src/index.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "wasm/*.ts", "test/**/*.ts"]
}
